{
  "feature_names": [
    "accelerometer#mean",
    "accelerometer#standard_deviation",
    "accelerometer#range",
    "accelerometer#minimum",
    "gyroscope#mean",
    "gyroscope#standard_deviation",
    "gyroscope#range",
    "gyroscope#minimum",
    "magnetometer#standard_deviation",
    "magnetometer#range",
    "magnetometer#minimum"
  ],
